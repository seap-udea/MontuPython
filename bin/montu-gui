#!/usr/bin/env bash
# Launch MontuPython Desktop from the development repository.
#
# Usage:
#   ./bin/montu-gui
#   ./bin/montu-gui --debug
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO"

if [[ -f "$REPO/.venv/bin/activate" ]]; then
    # shellcheck source=/dev/null
    source "$REPO/.venv/bin/activate"
fi

export MONTUPY_GUI_ROOT="$REPO"
exec python "$REPO/montu/bin/montu-gui" "$@"
